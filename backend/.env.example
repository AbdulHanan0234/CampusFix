# Copy this file to .env and fill in your own values.
# MongoDB Atlas: Cluster → Connect → Drivers → copy the connection string.
# (Local MongoDB would be: mongodb://127.0.0.1:27017/campusfixcluster)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/campusfixcluster
JWT_SECRET=replace_with_a_long_random_string
PORT=5000

# Gemini (free tier) AI assistant — get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=replace_with_your_gemini_key
GEMINI_MODEL=gemini-2.5-flash
